# ============================================================
# SkillSphere Environment Configuration Template
# Copy this file to .env and configure your values.
# Do NOT commit actual secrets or passwords to version control.
# ============================================================

# Django Security Settings
SECRET_KEY=your-secret-key-here-min-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=skillsphere
DB_USER=skillsphere_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5436

# Docker Compose PostgreSQL Settings (if running DB in Docker)
POSTGRES_DB=skillsphere
POSTGRES_USER=skillsphere_user
POSTGRES_PASSWORD=your-secure-database-password

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# AI Learning Assistant Configuration (Stage 14 & 15)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT=30
AI_RATE_LIMIT=30/minute
AI_MAX_LESSON_CHARS=15000
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_RESPONSE_CHARS=4000

# Database Connection Lifetime (seconds, 0 = close per request)
CONN_MAX_AGE=0

# HTTPS & Reverse Proxy Settings (Stage 22.2)
# Set SECURE_PROXY_SSL_HEADER=True ONLY when running behind a trusted reverse proxy (Nginx, ALB, Cloudflare)
SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# CSRF Trusted Origins (comma-separated URLs, wildcards disallowed)
# Defaults to localhost in dev/Docker; production deployments with public hostnames must define this explicitly.
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8000,http://127.0.0.1:8000
