# ============================================================
# SkillSphere Environment Configuration Template
# Copy this file to .env and configure your values.
# Do NOT commit actual secrets or passwords to version control.
# ============================================================

# Django Security Settings
SECRET_KEY=your-secret-key-here-min-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=skillsphere
DB_USER=skillsphere_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5436

# Docker Compose PostgreSQL Settings (if running DB in Docker)
POSTGRES_DB=skillsphere
POSTGRES_USER=skillsphere_user
POSTGRES_PASSWORD=your-secure-database-password

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
